#!/usr/bin/env bash
# REXMIT_MANAGEMENT_SCRIPT=1
set -Eeuo pipefail

SCRIPT_PATH=$(readlink -f -- "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
SCRIPT_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)

if [[ -f $SCRIPT_DIR/lib/common.sh ]]; then
    LIBRARY_DIR=$SCRIPT_DIR/lib
else
    LIBRARY_DIR=/usr/local/lib/rexmit
fi
[[ -f $LIBRARY_DIR/common.sh ]] || {
    printf 'error: Rexmit management modules not found at %s. Re-run install from the source checkout.\n' "$LIBRARY_DIR" >&2
    exit 1
}

source "$LIBRARY_DIR/common.sh"
source "$LIBRARY_DIR/config.sh"
source "$LIBRARY_DIR/dependencies.sh"
source "$LIBRARY_DIR/service.sh"
source "$LIBRARY_DIR/releases.sh"
source "$LIBRARY_DIR/lifecycle.sh"

command_name=${1:-help}
shift || true
ASSUME_YES=${ASSUME_YES:-0}
FOLLOW_LOGS=0
for argument in "$@"; do
    case $argument in
        --yes) ASSUME_YES=1 ;;
        --follow)
            [[ $command_name == logs ]] || die "--follow is only valid with logs."
            FOLLOW_LOGS=1
            ;;
        *) die "Unexpected argument: $argument" ;;
    esac
done

case $command_name in
    install|update|update-deps|rollback|start|stop|restart|uninstall|remove-deps|purge-config|purge-manager|doctor)
        check_manager_lock "$command_name"
        ;;
esac

case $command_name in
    setup) setup_config ;;
    install) install_bot ;;
    update) update_bot ;;
    update-deps) update_dependencies ;;
    rollback)
        require_root rollback
        [[ -f $SERVICE_FILE ]] || die "Rexmit is not installed."
        rollback_release
        ;;
    version) show_versions ;;
    doctor) doctor ;;
    start)
        require_root start
        start_service_and_wait
        ;;
    stop)
        require_root stop
        systemctl stop rexmit.service
        ;;
    restart)
        require_root restart
        restart_service_and_wait
        ;;
    status) show_status ;;
    logs) show_logs ;;
    uninstall) uninstall_bot ;;
    remove-deps) remove_dependencies ;;
    purge-config) purge_config ;;
    purge-manager) purge_manager ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "Unknown command: $command_name" ;;
esac
